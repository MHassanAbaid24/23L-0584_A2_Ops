# Copy to .env and fill in. .env is git-ignored — never commit it.

# --- DagsHub / MLflow (Task 3) ---
DAGSHUB_USER=
DAGSHUB_TOKEN=
MLFLOW_TRACKING_URI=https://dagshub.com/<DAGSHUB_USER>/23L-0584_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- Web app (Task 4/5) ---
MODEL_PATH=models/champion.keras
# MODEL_CONFIG_PATH=models/serving_config.json   # default: next to MODEL_PATH
# THRESHOLD=                                      # optional override of the champion's threshold
DATABASE_URL=sqlite:///instance/visionguard.db
MAX_UPLOAD_MB=10
SECRET_KEY=
LOG_LEVEL=INFO

# --- Docker Compose stack (Task 6.3) ---
# Password of the PostgreSQL service; Compose builds the web app's DATABASE_URL from it (db:5432 on the internal
# network). Generate one: python -c "import secrets; print(secrets.token_hex(16))"
# Note: PostgreSQL stores the password when its volume is first initialised; changing it later needs ALTER USER
# (or `docker compose down -v`, which deletes the data).
POSTGRES_PASSWORD=
# SECRET_KEY above is also required by the Compose stack.

# --- Remote inference (Task 8) ---
INFERENCE_MODE=local
MODEL_API_URL=https://23l-0584-a2-ops.vercel.app
MODEL_API_KEY=
MODEL_API_TIMEOUT=20

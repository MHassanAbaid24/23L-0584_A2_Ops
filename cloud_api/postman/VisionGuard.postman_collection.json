{
  "info": {
    "_postman_id": "4d4d3faa-72c1-4b4b-a0e5-8d07bff55b04",
    "name": "VisionGuard cloud API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://23l-0584-a2-ops.vercel.app"
    },
    {
      "key": "apiKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('returns 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('returns health metadata', () => { pm.expect(body.status).to.eql('ok'); pm.expect(body.runtime).to.eql('tflite'); pm.expect(body.model_version).to.eql('3'); pm.expect(body.img_size).to.eql(224); });"
          ]
        }
      }]
    },
    {
      "name": "Predict real image",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "image", "type": "file", "src": "data/raw/RealArt/spider-monkey-gty-ps-230705_1688589803900_hpEmbed_sl_3x2.jpg" }]
        },
        "url": "{{baseUrl}}/api/predict"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('returns 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('returns real prediction fields', () => { pm.expect(body.label).to.eql('real'); pm.expect(body.runtime).to.eql('tflite'); pm.expect(body).to.have.all.keys('label', 'confidence', 'p_ai', 'threshold', 'model_name', 'model_version', 'source_run', 'latency_ms', 'runtime'); });"
          ]
        }
      }]
    },
    {
      "name": "Predict AI image",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "image", "type": "file", "src": "data/raw/AiArtData/1000_F_551420122_DMVybsWtGw1kS6ogwlk66jcm78PmUIgn.jpg" }]
        },
        "url": "{{baseUrl}}/api/predict"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('returns 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('returns AI prediction fields', () => { pm.expect(body.label).to.eql('ai'); pm.expect(body.runtime).to.eql('tflite'); pm.expect(body).to.have.all.keys('label', 'confidence', 'p_ai', 'threshold', 'model_name', 'model_version', 'source_run', 'latency_ms', 'runtime'); });"
          ]
        }
      }]
    },
    {
      "name": "Predict without key (401)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "image", "type": "file", "src": "data/raw/AiArtData/1000_F_551420122_DMVybsWtGw1kS6ogwlk66jcm78PmUIgn.jpg" }]
        },
        "url": "{{baseUrl}}/api/predict"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.test('returns 401', () => pm.response.to.have.status(401));", "pm.test('returns JSON error', () => pm.expect(pm.response.json().error).to.be.a('string'));"] }
      }]
    },
    {
      "name": "Predict wrong key (401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-API-Key", "value": "wrong-key" }],
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "image", "type": "file", "src": "data/raw/AiArtData/1000_F_551420122_DMVybsWtGw1kS6ogwlk66jcm78PmUIgn.jpg" }]
        },
        "url": "{{baseUrl}}/api/predict"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.test('returns 401', () => pm.response.to.have.status(401));", "pm.test('returns JSON error', () => pm.expect(pm.response.json().error).to.be.a('string'));"] }
      }]
    },
    {
      "name": "Predict TIFF (415)",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "image", "type": "file", "src": "cloud_api/postman/fixtures/unsupported.tiff" }]
        },
        "url": "{{baseUrl}}/api/predict"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.test('returns 415', () => pm.response.to.have.status(415));", "pm.test('returns JSON error', () => pm.expect(pm.response.json().error).to.be.a('string'));"] }
      }]
    }
  ]
}
